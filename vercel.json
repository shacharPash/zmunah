{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/poster",
      "destination": "/api/poster"
    },
    {
      "source": "/api/poster",
      "destination": "/api/poster"
    },
    {
      "source": "/upcoming-events",
      "destination": "/api/upcoming_events"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/telegram_webhook"
    },
    {
      "source": "/omer-info",
      "destination": "/api/omer_info"
    }
  ],
  "crons": [
    {
      "path": "/api/shabbat_reminder",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/shabbat_reminder",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/omer_reminder",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/omer_reminder",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/omer_morning_reminder",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/omer_morning_reminder",
      "schedule": "0 8 * * *"
    }
  ]
}
